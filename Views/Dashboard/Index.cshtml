@model List<BarcodeApi.Models.Scan>

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Barcode Dashboard</title>

    <style>
        :root {
            --bg: #0b1220;
            --card: #111a2e;
            --card2: #0f172a;
            --text: #e5e7eb;
            --muted: #9ca3af;
            --accent: #60a5fa;
            --border: #1f2a44;
        }

        body {
            margin: 0;
            font-family: Arial, sans-serif;
            background: var(--bg);
            color: var(--text);
        }

        .container {
            max-width: 1100px;
            margin: auto;
            padding: 24px;
        }

        .header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 20px;
        }

        .title {
            font-size: 22px;
            font-weight: bold;
            letter-spacing: 0.5px;
        }

        .grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
            gap: 16px;
            margin-bottom: 20px;
        }

        .card {
            background: var(--card);
            padding: 16px;
            border-radius: 12px;
            border: 1px solid var(--border);
            box-shadow: 0 6px 18px rgba(0,0,0,0.25);
        }

        .card h2 {
            margin: 0;
            font-size: 28px;
            color: var(--accent);
        }

        .card p {
            margin: 6px 0 0;
            color: var(--muted);
            font-size: 13px;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            background: var(--card);
            border-radius: 12px;
            overflow: hidden;
            border: 1px solid var(--border);
        }

        th, td {
            padding: 12px;
            text-align: left;
        }

        th {
            background: var(--card2);
            color: var(--muted);
            font-size: 12px;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        tr {
            border-bottom: 1px solid var(--border);
        }

        tr:hover {
            background: #16223a;
        }

        .badge {
            display: inline-block;
            padding: 4px 8px;
            border-radius: 6px;
            font-size: 12px;
            background: #1f2a44;
            color: var(--accent);
            border: 1px solid var(--border);
        }

        .status {
            color: var(--muted);
            font-size: 13px;
        }
    </style>
</head>

<body>

<div class="container">

    <div class="header">
        <div class="title">📊 Barcode Scanner Dashboard</div>
        <div class="status">Live Report</div>
    </div>

    <!-- CARDS -->
    <div class="grid">
        <div class="card">
            <h2>@ViewBag.TotalScans</h2>
            <p>Total Scans</p>
        </div>

        <div class="card">
            <h2>@Model.Count</h2>
            <p>Recent Records</p>
        </div>

        <div class="card">
            <h2>Online</h2>
            <p>System Status</p>
        </div>
    </div>

    <!-- TABLE -->
    <div class="card">
        <table>
            <thead>
                <tr>
                    <th>Code</th>
                    <th>Format</th>
                    <th>Date</th>
                    <th>Store</th>
                </tr>
            </thead>

            <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Code</td>
                    <td><span class="badge">@item.Format</span></td>
                    <td>
                        @TimeZoneInfo.ConvertTimeFromUtc(
                            item.ScannedAtUtc,
                            TimeZoneInfo.FindSystemTimeZoneById("Singapore Standard Time")
                        ).ToString("MMM dd, yyyy hh:mm:ss tt")
                    </td>
                    <td>@item.StoreId</td>
                </tr>
            }
            </tbody>
        </table>
    </div>

</div>
<script>
    document.addEventListener("DOMContentLoaded", function () {

        document.querySelectorAll(".utc-time").forEach(el => {

            const utcValue = el.innerText;

            if (!utcValue) return;

            const date = new Date(utcValue);

            el.innerText = date.toLocaleString();

        });

    });
</script>
</body>
</html>